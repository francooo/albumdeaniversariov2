{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"tsx watch server/dev.ts\" \"vite --port=5000 --host=0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "dev:web": "vite --port=5000 --host=0.0.0.0",
    "dev:api": "tsx watch server/dev.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate-files": "tsx scripts/migrate-files.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1179.0",
    "@aws-sdk/s3-request-presigner": "^3.1179.0",
    "@google/genai": "^1.29.0",
    "@hono/node-server": "^1.19.19",
    "@neondatabase/serverless": "^1.0.2",
    "@react-oauth/google": "^0.13.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hono": "^4.13.23",
    "jose": "^5.10.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nanoid": "^5.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
